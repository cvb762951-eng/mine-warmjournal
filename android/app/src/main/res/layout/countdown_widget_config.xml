<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/countdown_config_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/countdown_widget_classic_page">

    <TextView
        android:id="@+id/countdown_config_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="显示哪一条倒数日"
        android:textColor="@color/countdown_widget_classic_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/countdown_config_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="还没有倒数日。先在 App 里添加，再回来选择。"
        android:textColor="@color/countdown_widget_classic_muted"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <RadioGroup
            android:id="@+id/countdown_config_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <Button
        android:id="@+id/countdown_config_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="完成" />
</LinearLayout>
